HOST=127.0.0.1
PORT=4173
INBOX_DOMAIN=haruemail.com
# "cloudflare" uses cloudflare-email-worker; omit to keep Resend while migrating.
MAIL_RECEIVER=cloudflare
# Random long value shared with the Worker as INGEST_SECRET.
CLOUDFLARE_EMAIL_WEBHOOK_SECRET=
# Required when MAIL_RECEIVER=cloudflare; keep this independent from provider keys.
MAILBOX_SECRET=
RESEND_API_KEY=
MESSAGES_SUPABASE_TABLE=mail_messages
# Optional: stable random secret of at least 32 bytes. Keep private.
MAILBOX_SECRET=
# Public contact email after operator confirmation
SUPPORT_EMAIL=
# Real account identifier, pub- followed by 16 digits
ADSENSE_PUBLISHER_ID=
# Canonical public HTTPS origin; no path
SITE_ORIGIN=https://www.haruemail.com
